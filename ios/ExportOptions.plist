	<string>app-store-connect</string>
	<key>teamID</key>
	<!-- Dean's Apple Developer team (matches the mini's Apple Distribution identity and the
	     Ringpool App ID/provisioning profile). 765RD9BJ8C was the upstream VENDOR's team and
	     made exports fail with "App Store Connect access for 765RD9BJ8C is required". -->
	<string>ZGKJ6KP5MX</string>
	<key>signingStyle</key>
